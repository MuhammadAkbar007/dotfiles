// Ctrl+j/k navigation in widgets nvim can't reach (quick pick, suggestions, lists).
// Each entry is scoped by `when`, so the defaults (ctrl+j = toggle panel) still
// apply everywhere else.
[
  // Quick open / command palette / any quick pick
  {
    "key": "ctrl+j",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen"
  },

  // Autocomplete popup
  {
    "key": "ctrl+j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"
  },

  // Explorer, references, problems, any tree/list
  {
    "key": "ctrl+j",
    "command": "list.focusDown",
    "when": "listFocus && !inputFocus"
  },
  {
    "key": "ctrl+k",
    "command": "list.focusUp",
    "when": "listFocus && !inputFocus"
  },

  // Esc closes the editor find widget (its match highlights linger otherwise).
  // Two focus states: typing in the find box (findInputFocussed) or cursor
  // back in the editor text with the widget still open (editorFocus). Cover
  // both; the find box has no vim mode, so Esc there is pure VSCode. Everywhere
  // else Esc still reaches nvim for normal mode.
  {
    "key": "escape",
    "command": "closeFindWidget",
    "when": "findInputFocussed && findWidgetVisible"
  },
  {
    "key": "escape",
    "command": "closeFindWidget",
    "when": "editorFocus && findWidgetVisible"
  },

  // Esc dismisses the Search sidebar (space fs/fc), like Esc closing a telescope
  // picker. Fires whether the search box or the results list has focus.
  {
    "key": "escape",
    "command": "workbench.action.closeSidebar",
    "when": "searchViewletFocus"
  },

  // <leader>e toggle-off. nvim owns <leader>e in the editor (reveal + focus
  // tree); once focus is in the tree nvim is out of the loop, so the same
  // chord has to be re-declared here to close.
  // Cost: space is a chord prefix in the explorer, so type-ahead filter waits
  // on it. Accepted deliberately in favour of a symmetric <leader>e toggle.
  {
    "key": "space e",
    "command": "workbench.action.closeSidebar",
    "when": "filesExplorerFocus && !inputFocus"
  },

  // Same close, second way out. Guards differ: escape must still cancel a
  // rename (!inputFocus) and clear a multi-select (!listMultiSelection) first.
  {
    "key": "escape",
    "command": "workbench.action.closeSidebar",
    "when": "filesExplorerFocus && !inputFocus && !listMultiSelection"
  },

  // <leader>ff with no editor open. nvim only receives keys while a text
  // editor has focus, so on the empty workbench the nvim map is unreachable
  // and this stands in for it. Scoped to !editorTextFocus so nvim keeps
  // owning <leader>ff whenever a file is actually open.
  {
    "key": "space f f",
    "command": "workbench.action.quickOpen",
    "when": "!editorTextFocus && !inputFocus"
  },

  // The nvim leader maps, duplicated for non-editor surfaces (notebook command
  // mode, explorer, empty workbench) where nvim receives no keys. All scoped
  // !editorTextFocus so nvim keeps owning them inside real editors. Only global
  // commands are here; cursor-dependent maps (gd, K, rename, diagnostics,
  // folding, code actions) are meaningless without an editor and stay
  // nvim-only by design.
  {
    "key": "space space",
    "command": "workbench.action.showAllEditors",
    "when": "!editorTextFocus && !inputFocus"
  },
  // <leader>e reveal-in-tree, the open half. The close half is the `space e` /
  // `escape` -> closeSidebar bindings above; guard !filesExplorerFocus so this
  // twin doesn't collide with them once the tree has focus.
  {
    "key": "space e",
    "command": "workbench.files.action.showActiveFileInExplorer",
    "when": "!editorTextFocus && !filesExplorerFocus && !inputFocus"
  },
  {
    "key": "space f r",
    "command": "workbench.action.openRecent",
    "when": "!editorTextFocus && !inputFocus"
  },
  {
    "key": "space f s",
    "command": "workbench.action.findInFiles",
    "when": "!editorTextFocus && !inputFocus"
  },
  {
    "key": "space f c",
    "command": "workbench.action.findInFiles",
    "when": "!editorTextFocus && !inputFocus"
  },
  {
    "key": "space f t",
    "command": "todo-tree.list",
    "when": "!editorTextFocus && !inputFocus"
  },
  {
    "key": "space t c",
    "command": "workbench.files.action.collapseExplorerFolders",
    "when": "!editorTextFocus && !inputFocus"
  },
  {
    "key": "space l g",
    "command": "workbench.view.scm",
    "when": "!editorTextFocus && !inputFocus"
  },
  {
    "key": "space q",
    "command": "workbench.action.closeActiveEditor",
    "when": "!editorTextFocus && !inputFocus"
  },
  {
    "key": "space w w",
    "command": "workbench.action.closeActiveEditor",
    "when": "!editorTextFocus && !inputFocus"
  },
  {
    "key": "space s q",
    "command": "runCommands",
    "args": {
      "commands": ["workbench.action.files.save", "workbench.action.closeActiveEditor"]
    },
    "when": "!editorTextFocus && !inputFocus"
  },
  {
    "key": "space s m",
    "command": "workbench.action.toggleMaximizeEditorGroup",
    "when": "!editorTextFocus && !inputFocus"
  },

  // <C-e>/<C-y> line scroll. The extension already contributes these, but its
  // binding was losing to VSCode's default (ctrl+e = quickOpen); a user
  // binding outranks both. Calls the extension's own commands, so nvim's
  // cursor/viewport stay in sync rather than drifting from the editor.
  {
    "key": "ctrl+e",
    "command": "vscode-neovim.ctrl-e",
    "when": "editorTextFocus && neovim.init && neovim.mode != insert"
  },
  {
    "key": "ctrl+y",
    "command": "vscode-neovim.ctrl-y",
    "when": "editorTextFocus && neovim.init && neovim.mode != insert"
  },

  // Same keys inside notebooks. A notebook is a virtualized list of separate
  // cell editors, so vscode-neovim.ctrl-e scrolls only the active cell's
  // viewport - already fully visible, hence a no-op. The thing that actually
  // scrolls is the cell list. Must stay AFTER the bindings above: both match
  // in a cell, and the later one wins.
  {
    "key": "ctrl+e",
    "command": "list.scrollDown",
    "when": "notebookEditorFocused && neovim.mode != insert"
  },
  {
    "key": "ctrl+y",
    "command": "list.scrollUp",
    "when": "notebookEditorFocused && neovim.mode != insert"
  },

  // Treesitter incremental_selection equivalent. The nvim config binds
  // <C-space> to init/expand and <bs> to shrink; treesitter isn't loaded in
  // VSCode, so smartSelect (syntax-aware, from the language provider) stands
  // in. Expanding the VSCode selection flips nvim into visual mode on its own.
  // Scoped to non-insert so ctrl+space still triggers suggest while typing.
  {
    "key": "ctrl+space",
    "command": "editor.action.smartSelect.expand",
    "when": "editorTextFocus && neovim.init && neovim.mode != insert"
  },
  {
    "key": "backspace",
    "command": "editor.action.smartSelect.shrink",
    "when": "editorTextFocus && neovim.init && neovim.mode != insert && editorHasSelection"
  },

  // Enter on a file: open it, then close the sidebar.
  // Folders keep default expand/collapse; rename input keeps default confirm.
  {
    "key": "enter",
    "command": "runCommands",
    "args": {
      "commands": ["explorer.openAndPassFocus", "workbench.action.closeSidebar"]
    },
    "when": "filesExplorerFocus && !explorerResourceIsFolder && !inputFocus"
  },

  // ctrl+hjkl split/pane navigation, parity with vim-tmux-navigator in the
  // terminal config. navigate{Left,Right,Up,Down} cross the whole workbench -
  // editor groups AND the terminal panel - so one keyset moves editor<->editor
  // and editor<->terminal seamlessly. Editor side is normal-mode only so
  // insert-mode ctrl+h (VSCode's replace) etc. survive. In the terminal these
  // shadow readline ctrl+h/j/k/l (backspace/enter/kill/clear) - the same trade
  // the tmux navigator already makes there.
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "editorTextFocus && neovim.mode != insert"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "editorTextFocus && neovim.mode != insert"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.navigateUp",
    "when": "editorTextFocus && neovim.mode != insert"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.navigateDown",
    "when": "editorTextFocus && neovim.mode != insert"
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.navigateUp",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.navigateDown",
    "when": "terminalFocus"
  },
  // Same split nav from notebook command mode (cell selected, not editing) -
  // not editorTextFocus, so the editor bindings above miss it. Only h/l here:
  // ctrl+j/k stay owned by list.focusDown/Up for cell-to-cell movement.
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "notebookEditorFocused && !editorTextFocus"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "notebookEditorFocused && !editorTextFocus"
  },

  // <C-w>q closes the split, no-op on the last pane. This block is the
  // !editorTextFocus half (explorer, panels, empty group); the in-editor half
  // lives in vscode-init.lua because there nvim owns <C-w>q. First kill the
  // extension's own ctrl+w q (it ran closeActiveEditor, which closes the last
  // editor too)...
  {
    "key": "ctrl+w q",
    "command": "-workbench.action.closeActiveEditor",
    "when": "!editorTextFocus && neovim.mode != 'cmdline' && !terminalFocus && !filesExplorerFocus && !searchViewletFocus"
  },
  // ...then close the whole group, but only when there's more than one, so a
  // lone pane stays put.
  {
    "key": "ctrl+w q",
    "command": "workbench.action.closeEditorsAndGroup",
    "when": "!editorTextFocus && !terminalFocus && multipleEditorGroups"
  },
  // Ctrl-held variant: pressing q without releasing Ctrl reads as ctrl+q.
  {
    "key": "ctrl+w ctrl+q",
    "command": "workbench.action.closeEditorsAndGroup",
    "when": "!editorTextFocus && !terminalFocus && multipleEditorGroups"
  }
]
